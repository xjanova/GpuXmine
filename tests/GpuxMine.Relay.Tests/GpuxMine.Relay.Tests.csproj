<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GpuxMine.Relay.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- The relay is an ASP.NET Core app; its tests run it in-process on a
         TestServer (and, for the real agent round trip, on a loopback port). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GpuxMine.Relay\GpuxMine.Relay.csproj" />
    <!-- The real agent side, so "a new agent against this relay" is tested
         with the code that ships rather than a model of it. -->
    <ProjectReference Include="..\..\src\GpuxMine.Node\GpuxMine.Node.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
