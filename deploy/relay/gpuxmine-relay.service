[Unit]
Description=GPUxMINE relay — เครื่องที่บ้านคนโทรเข้ามาที่นี่
Documentation=https://github.com/xjanova/GpuXmine
After=network-online.target
Wants=network-online.target

[Service]
# notify ไม่ได้ เพราะ ASP.NET Core จะส่งสัญญาณ ready กลับให้ systemd ก็ต่อเมื่อ
# เรียก UseSystemd() ซึ่ง relay ไม่ได้เรียก — ผลคือ systemd ค้างที่ activating
# แล้วฆ่าทิ้งเมื่อครบ TimeoutStartSec ทั้งที่ตัวโปรแกรมตอบ /healthz อยู่ดี ๆ
# (เจอจริงตอนติดตั้งครั้งแรกบนเซิร์ฟเวอร์ TPIX)
#
# exec = ถือว่าขึ้นแล้วเมื่อ execve สำเร็จ ซึ่งตรงกับสิ่งที่โปรแกรมนี้รับประกันได้จริง
Type=exec
# Self-contained .NET publish: no runtime to install, nothing to keep in step
# with the distro's packages.
ExecStart=/opt/gpuxmine-relay/current/GpuxMine.Relay
WorkingDirectory=/opt/gpuxmine-relay/current

# Localhost only. The reverse proxy in front is what terminates TLS and what
# the open internet can reach; binding this publicly would expose a relay whose
# only auth on /w/ is the per-worker token.
Environment=ASPNETCORE_URLS=http://127.0.0.1:5080
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

# The enrolment reply is built from the request's scheme and host. Behind a
# proxy that is localhost HTTP, so without this every node is handed a ws://
# URL and every endpoint an http:// one — which aixman then refuses.
Environment=Relay__TrustProxy=true

# The store outlives a release: it holds every worker id and token hash in the
# fleet. Losing it tells every node its token is invalid.
Environment=Relay__StorePath=/var/lib/gpuxmine-relay/workers.json

# The key that can enrol a worker anywhere in the network. Only XMAN Studio
# holds the other copy. Keep it out of this file:
#   /etc/gpuxmine-relay.env  →  GPUXMINE_ADMIN_KEY=...   (chmod 600)
EnvironmentFile=/etc/gpuxmine-relay.env

User=gpuxmine
Group=gpuxmine
Restart=always
RestartSec=5

# หลายร้อย websocket ค้างพร้อมกัน — ค่า default 1024 ไม่พอ
LimitNOFILE=65535

# ── เพดานทรัพยากร ───────────────────────────────────────────────────────────
# relay อาจไปอยู่ร่วมเครื่องกับงานที่สำคัญกว่ามัน — บนเซิร์ฟเวอร์ TPIX คือ
# validator ของบล็อกเชนที่ไวต่อ latency และเคยค้างไป 38 ชั่วโมงโดยไม่มีใครรู้
#
# เพดานพวกนี้ไม่ใช่การจูนประสิทธิภาพ แต่เป็นสัญญาว่า "ต่อให้ relay ถูกยิงถล่ม
# หรือรั่ว มันก็แตะได้ไม่เกินนี้" ตัว relay เองใช้ราว 300 MB และแทบไม่กิน CPU
# เพราะงานหนักอยู่ที่การ์ดจอของคนอื่น ที่นี่แค่ส่งไบต์ผ่าน
CPUQuota=400%
MemoryHigh=768M
MemoryMax=1G
TasksMax=512

# ต่ำกว่า default (100) — ถ้าดิสก์แย่งกัน ให้ validator ได้ไปก่อน
IOWeight=50
Nice=5

# A relay that cannot write outside its own state directory is a relay that
# cannot be turned into a foothold on the box that also serves the website.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gpuxmine-relay
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
