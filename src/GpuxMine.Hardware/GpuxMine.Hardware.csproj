<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>GpuxMine.Hardware</RootNamespace>
    <!-- SYSLIB1054 asks for LibraryImport over DllImport. Two Win32 calls with
         a struct ref and an enum out are exactly what DllImport handles best;
         the source-generated form buys nothing here. -->
    <NoWarn>$(NoWarn);SYSLIB1054</NoWarn>
    <!-- Windows only, on purpose: this is the one project allowed to talk to
         drivers and Win32. Everything it learns crosses into the node through
         the interfaces in GpuxMine.Node, so a Linux host can bring its own. -->
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- EventLogReader, to ask the System log how many times this machine has
         lost power without shutting down. An XPath query against the log costs
         milliseconds; walking it in managed code would cost seconds. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GpuxMine.Node\GpuxMine.Node.csproj" />
  </ItemGroup>
</Project>
