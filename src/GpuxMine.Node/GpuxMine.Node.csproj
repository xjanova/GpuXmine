<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>GpuxMine.Node</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Local store for settings, the job ledger and the activity log. The
         bundled SQLite build means no system dependency on the owner's PC. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Microsoft.Data.Sqlite 10.0.0 still pulls SQLitePCLRaw 2.1.11, whose
         native e_sqlite3 carries GHSA-2m69-gcr7-jv3q (high). Pinned forward
         rather than suppressed: this library is parsed on every node in the
         fleet, on machines we do not administer. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <!-- Reading the node's settings moved here so the window and the headless
         agent cannot disagree about where agent.json lives — they had already
         drifted once, and the identity file is the one thing both must read
         identically. -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Everything a node does, with no UI and no Windows dependency: the
         console agent, the WPF app and the Linux build all host this one
         library. Platform-specific sensing comes in through interfaces. -->
    <ProjectReference Include="..\GpuxMine.Protocol\GpuxMine.Protocol.csproj" />
    <ProjectReference Include="..\GpuxMine.Core\GpuxMine.Core.csproj" />
  </ItemGroup>
</Project>
