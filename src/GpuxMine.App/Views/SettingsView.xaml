<UserControl x:Class="GpuxMine.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GpuxMine.App.Controls">
    <UserControl.Resources>
        <c:CellStateToBrush x:Key="CellBrush" Share="{StaticResource GoldCell}" Cheap="{StaticResource BlueCell}" Mine="{StaticResource GreyFill}"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="330"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*" MinWidth="250" MaxWidth="360"/></Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource ChromePanelStyle}">
                <StackPanel>
                    <TextBlock Text="WEEKLY SCHEDULE" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                    <TextBlock Text="ช่องทองคือชั่วโมงที่แชร์ ช่องฟ้าคือแชร์ในช่วงไฟถูก ช่องเทาคือเวลาของคุณ — คลิกเพื่อสลับ" Style="{StaticResource Muted}" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,16,0,0">
                            <TextBlock Text="MON" Style="{StaticResource Mono}" FontSize="9.5" Height="22"/>
                            <TextBlock Text="TUE" Style="{StaticResource Mono}" FontSize="9.5" Height="22"/>
                            <TextBlock Text="WED" Style="{StaticResource Mono}" FontSize="9.5" Height="22"/>
                            <TextBlock Text="THU" Style="{StaticResource Mono}" FontSize="9.5" Height="22"/>
                            <TextBlock Text="FRI" Style="{StaticResource Mono}" FontSize="9.5" Height="22"/>
                            <TextBlock Text="SAT" Style="{StaticResource Mono}" FontSize="9.5" Height="22"/>
                            <TextBlock Text="SUN" Style="{StaticResource Mono}" FontSize="9.5" Height="22"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <Grid Height="14">
                                <TextBlock Text="00" Style="{StaticResource Mono}" FontSize="9.5" HorizontalAlignment="Left"/>
                                <TextBlock Text="06" Style="{StaticResource Mono}" FontSize="9.5" HorizontalAlignment="Left" Margin="132,0,0,0"/>
                                <TextBlock Text="12" Style="{StaticResource Mono}" FontSize="9.5" HorizontalAlignment="Left" Margin="264,0,0,0"/>
                                <TextBlock Text="18" Style="{StaticResource Mono}" FontSize="9.5" HorizontalAlignment="Left" Margin="396,0,0,0"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ScheduleCells}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="24" Rows="7"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding Toggle}" Height="19" Margin="1.5" Cursor="Hand" ToolTip="{Binding Hour}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border CornerRadius="2" Background="{Binding State, Converter={StaticResource CellBrush}}" BorderBrush="#9aa3ad" BorderThickness="0.5"/>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="34,8,0,0">
                        <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource GoldCell}" Margin="0,0,5,0"/><TextBlock Text="sharing" Style="{StaticResource Mono}" FontSize="10" Margin="0,0,14,0"/>
                        <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource GreyFill}" BorderBrush="#9aa3ad" BorderThickness="0.5" Margin="0,0,5,0"/><TextBlock Text="my time" Style="{StaticResource Mono}" FontSize="10" Margin="0,0,14,0"/>
                        <Border Width="12" Height="12" CornerRadius="2" Background="{StaticResource BlueCell}" Margin="0,0,5,0"/><TextBlock Text="cheap power window" Style="{StaticResource Mono}" FontSize="10"/>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{StaticResource ChromeBorderLight}" Margin="0,12"/>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartWithWindows}">
                        <StackPanel><TextBlock Text="Start with Windows" Style="{StaticResource BodyBold}"/><TextBlock Text="เปิดพร้อม Windows แล้วแชร์ต่อจากที่ค้างไว้ (เขียนคีย์ Run ของผู้ใช้ปัจจุบัน)" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Notifications}" Margin="0,10,0,0">
                        <StackPanel><TextBlock Text="Payout &amp; warning notifications" Style="{StaticResource BodyBold}"/><TextBlock Text="ยอดตัดเข้ากระเป๋า โหนดหลุด อุณหภูมิถึงเพดาน" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
                    </CheckBox>
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LeaderboardAnonymous}" Margin="0,10,0,0">
                        <StackPanel><TextBlock Text="ไม่ประสงค์ออกนามในทำเนียบผู้บริจาค" Style="{StaticResource BodyBold}"/><TextBlock Text="ยอดแชร์ฟรีของคุณจะแสดงเป็น 'ผู้ไม่ประสงค์ออกนาม'" Style="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel>
                    </CheckBox>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource ChromePanelStyle}">
                <StackPanel>
                    <TextBlock Text="POWER TARIFF" Style="{StaticResource SectionLabel}"/>
                    <!-- Widths carry the padding: 34 px left 18 px for the text and clipped "22" to nothing, and "4.20" to "4.2". -->
                    <Grid Margin="0,0,0,8"><TextBlock Text="Rate per kWh" Style="{StaticResource Body}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="฿" Style="{StaticResource Mono}" VerticalAlignment="Center"/><TextBox Style="{StaticResource ChromeInput}" Width="68" Padding="6,3" TextAlignment="Right" Text="{Binding Tariff, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"/></StackPanel></Grid>
                    <Grid Margin="0,0,0,8"><TextBlock Text="Off-peak window" Style="{StaticResource Body}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Style="{StaticResource ChromeInput}" Width="44" Padding="6,3" TextAlignment="Right" Text="{Binding OffPeakStart, UpdateSourceTrigger=LostFocus}"/><TextBlock Text=" – " Style="{StaticResource Mono}" VerticalAlignment="Center"/><TextBox Style="{StaticResource ChromeInput}" Width="44" Padding="6,3" TextAlignment="Right" Text="{Binding OffPeakEnd, UpdateSourceTrigger=LostFocus}"/></StackPanel></Grid>
                    <Grid><TextBlock Text="Off-peak rate" Style="{StaticResource Body}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="฿" Style="{StaticResource Mono}" VerticalAlignment="Center"/><TextBox Style="{StaticResource ChromeInput}" Width="68" Padding="6,3" TextAlignment="Right" Text="{Binding OffPeakRate, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.00}}"/></StackPanel></Grid>
                    <TextBlock Text="ใช้คำนวณค่าไฟในหน้า Power — ค่าไฟจริงของคุณดูได้จากบิล" Style="{StaticResource Muted}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ChromePanelStyle}" Margin="0,13,0,0">
                <StackPanel>
                    <TextBlock Text="NODE" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,0,0,6"><TextBlock Text="node id" Style="{StaticResource Body}"/><TextBlock Text="{Binding WorkerIdText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,6"><TextBlock Text="relay" Style="{StaticResource Body}"/><TextBlock Text="{Binding RelayHostText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/></Grid>
                    <Grid Margin="0,0,0,6"><TextBlock Text="client" Style="{StaticResource Body}"/><TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Right"><Run Text="v"/><Run Text="{Binding VersionText, Mode=OneWay}"/></TextBlock></Grid>
                    <Grid Margin="0,0,0,6"><TextBlock Text="machine" Style="{StaticResource Body}"/><TextBlock Text="{Binding MachineIdShort}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/></Grid>
                    
                    <TextBlock Text="{Binding ConfigureHint}" Style="{StaticResource Muted}" Foreground="{StaticResource RedDark}"/>

                    <!-- เครื่องที่ลงทะเบียนแล้วต้องได้ยินว่าลงทะเบียนแล้ว
                         ไม่ใช่ถูกถามให้ลงทะเบียนซ้ำทุกครั้งที่เปิดหน้านี้ -->
                    <Border Style="{StaticResource LcdPanelStyle}" Margin="0,10,0,0" Padding="12,10"
                            Visibility="{Binding ShowPairingForm, Converter={StaticResource VisInv}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="8" Height="8" Fill="#7fe07a" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#7fe07a" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="ลงทะเบียนแล้ว" Style="{StaticResource LcdValueGreen}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PairedSummary}" Style="{StaticResource LcdLabelText}" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="relay" Style="{StaticResource LcdLabelText}"/>
                                <TextBlock Text="{Binding RelayHostText}" Style="{StaticResource Mono}" FontSize="11"
                                           Foreground="{StaticResource LcdBlue}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Button Style="{StaticResource ChromeButton}" Content="เปิดหน้าเครื่องของฉัน" Margin="0,10,0,0"
                                    Command="{Binding OpenUrl}" CommandParameter="{Binding NodesUrl}"/>
                            <!-- ย้ายเครื่องไปบัญชีอื่น หรือถูกลบออกจากเว็บแล้วต้องผูกใหม่
                                 เป็นเรื่องจริงแต่นาน ๆ ครั้ง จึงซ่อนไว้หลังปุ่ม -->
                            <Button Style="{StaticResource ChromeButton}" Content="ลงทะเบียนใหม่ด้วยรหัสอื่น" Margin="0,6,0,0"
                                    Command="{Binding ChangePairing}"/>
                        </StackPanel>
                    </Border>

                    <!-- ลงทะเบียนเครื่อง: ทางเดียวที่เครื่องได้ตัวตนของตัวเอง -->
                    <Border Style="{StaticResource LcdPanelStyle}" Margin="0,10,0,0" Padding="12,10"
                            Visibility="{Binding ShowPairingForm, Converter={StaticResource Vis}}">
                        <StackPanel>
                            <TextBlock Text="ลงทะเบียนเครื่องกับ XMAN STUDIO" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                       Text="เข้าเว็บ XMAN Studio → เครื่องของฉัน → กดขอรหัสจับคู่ แล้วพิมพ์รหัส 8 ตัวที่ได้ลงในช่องนี้"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource ChromeInput}" Padding="8,5"
                                         FontFamily="{StaticResource MonoFont}" FontSize="15" CharacterCasing="Upper"
                                         MaxLength="9" Text="{Binding PairingCode, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Style="{StaticResource ChromeButton}" Content="ลงทะเบียน"
                                        Command="{Binding PairNode}" Margin="8,0,0,0" Width="100"
                                        IsEnabled="{Binding Pairing, Converter={StaticResource Not}}"/>
                            </Grid>
                            <TextBlock Text="{Binding PairingStatus}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Visibility="{Binding PairingStatus, Converter={StaticResource NullVis}}"/>
                            <Button Style="{StaticResource ChromeButton}" Content="เปิดหน้าเครื่องของฉัน" Margin="0,8,0,0"
                                    Command="{Binding OpenUrl}" CommandParameter="{Binding NodesUrl}"/>
                            <!-- ทางกลับ มีเฉพาะตอนที่เครื่องลงทะเบียนอยู่แล้ว
                                 เครื่องใหม่ที่ยังไม่มีตัวตนไม่มีอะไรให้ยกเลิกกลับไปหา -->
                            <Button Style="{StaticResource ChromeButton}" Content="ยกเลิก ใช้การลงทะเบียนเดิม" Margin="0,6,0,0"
                                    Command="{Binding CancelPairingChange}"
                                    Visibility="{Binding IsPaired, Converter={StaticResource Vis}}"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource ChromeButton}" Content="Run diagnostics" Command="{Binding RunDiagnostics}" Margin="0,10,0,0"/>
                    <Border Style="{StaticResource LcdPanelStyle}" Margin="0,10,0,0" Padding="10,8" Visibility="{Binding DiagnosticsText, Converter={StaticResource NullVis}}">
                        <TextBlock Text="{Binding DiagnosticsText}" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource LcdBlue}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
