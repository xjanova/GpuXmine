<UserControl x:Class="GpuxMine.App.Views.WalletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ทุกตัวเลขในหน้านี้มาจาก XMAN Studio เป็นสตางค์ ไม่มีการประมาณ ถ้ายังไม่มีข้อมูลขึ้น "—" พร้อมเหตุผล
         หน้านี้ไม่มีรายการเลื่อนได้ข้างใน จึงไม่มี ScrollViewer ซ้อน (ดู WheelScroll)

         เคยเป็นหน้า "WITHDRAWABLE BALANCE" ที่ผูกกับยอดวันนี้ พร้อมช่องถอนเข้า PromptPay / USDT
         และค่าธรรมเนียม — ทั้งที่ยังไม่มีการถอนเงินสดเลยสักช่องทาง ค่าตอบแทนเข้ากระเป๋า XMAN
         เท่านั้น หน้านี้จึงบอกแค่นั้น -->
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" MinWidth="330"/><ColumnDefinition Width="13"/><ColumnDefinition Width="*" MinWidth="250" MaxWidth="360"/></Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource LcdPanelStyle}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="XMAN WALLET BALANCE" Style="{StaticResource LcdLabelText}"/>
                    <TextBlock Text="{Binding WalletBalanceText}" Style="{StaticResource LcdValue}" FontSize="52" Margin="0,2,0,6"/>
                    <TextBlock Style="{StaticResource LcdLabelText}" Typography.Capitals="Normal" FontSize="10.5" TextWrapping="Wrap"
                               Text="{Binding WalletNote}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChromePanelStyle}" Margin="0,13,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="ค่าตอบแทนจากการแชร์การ์ด · ทั้งบัญชี" Style="{StaticResource SectionLabel}"/>
                        <Button Style="{StaticResource ChromeButton}" Content="รีเฟรช" Command="{Binding RefreshPool}" Width="80"
                                HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- สี่ขั้นที่งานหนึ่งงานเดินผ่านก่อนเป็นเงินในกระเป๋า เรียงตามลำดับจริง -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource LcdPanelStyle}" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="ระยะพัก" Style="{StaticResource LcdLabelText}" Typography.Capitals="Normal"/>
                                <TextBlock Text="{Binding EarnPendingText}" Style="{StaticResource LcdValueBlue}" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource LcdPanelStyle}" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="รอตรวจสอบ" Style="{StaticResource LcdLabelText}" Typography.Capitals="Normal"/>
                                <TextBlock Text="{Binding EarnReviewText}" Style="{StaticResource LcdValueBlue}" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Style="{StaticResource LcdPanelStyle}" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="รอเข้ากระเป๋า" Style="{StaticResource LcdLabelText}" Typography.Capitals="Normal"/>
                                <TextBlock Text="{Binding EarnClearedText}" Style="{StaticResource LcdValueBlue}" FontSize="15"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Style="{StaticResource LcdPanelStyle}" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="เข้ากระเป๋าแล้ว" Style="{StaticResource LcdLabelText}" Typography.Capitals="Normal"/>
                                <TextBlock Text="{Binding EarnPaidText}" Style="{StaticResource LcdValueGreen}" FontSize="15"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="วันนี้ (ทุกสถานะยกเว้นที่ถูกยกเลิก)" Style="{StaticResource Body}" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding EarnTodayText}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="เดือนนี้" Style="{StaticResource Body}" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EarnMonthText}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Text="ให้ pool ฟรี · 30 วันล่าสุด (มูลค่างาน ไม่ได้รับเป็นเงิน)" Style="{StaticResource Body}" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EarnDonatedText}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Text="ระยะพักก่อนเข้ากระเป๋า" Style="{StaticResource Body}" Margin="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding HoldText}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0" Text="{Binding EarningsFlowText}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="ค่าตอบแทนแยกทีละงานของเครื่องนี้ดูได้ที่หน้า History (คอลัมน์ PAYOUT และ POOL)"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding PoolRefreshNote, Converter={StaticResource NullVis}}" Text="{Binding PoolRefreshNote}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource ChromePanelStyle}">
                <StackPanel>
                    <TextBlock Text="เงินไปที่ไหน" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                               Text="ค่าตอบแทนเข้ากระเป๋า XMAN ของบัญชีที่จับคู่เครื่องนี้ ใช้จ่ายบน XMAN Studio และ AIXMAN ได้"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="ตอนนี้ยังถอนเป็นเงินสดไม่ได้ — ยอดในหน้านี้คือยอดในกระเป๋า XMAN ไม่ใช่ยอดที่โอนออกได้"/>
                    <Button Style="{StaticResource ChromeButton}" Content="เปิดกระเป๋าเงินที่ XMAN Studio" Command="{Binding OpenUrl}" CommandParameter="{Binding WalletUrl}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChromePanelStyle}" Margin="0,13,0,0">
                <StackPanel>
                    <TextBlock Text="สถานะแต่ละขั้น" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="ระยะพัก — งานเสร็จแล้ว รอครบเวลาพักก่อนตัดเข้ากระเป๋า"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="รอตรวจสอบ — ผู้ดูแลต้องดูก่อน ไม่เข้ากระเป๋าเอง"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="รอเข้ากระเป๋า — พ้นระยะพักแล้ว จะเข้าในรอบถัดไป (ทุกชั่วโมง)"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="เข้ากระเป๋าแล้ว — รวมอยู่ในยอดกระเป๋าด้านซ้ายแล้ว"/>
                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0" Text="ยกเลิก — งานที่ถูกยกเลิกไม่ได้ค่าตอบแทน และไม่นับในยอดใด ๆ"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
