<UserControl x:Class="GpuxMine.App.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GpuxMine.App.Controls">    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300" MaxWidth="420"/><ColumnDefinition Width="13"/><ColumnDefinition Width="2*" MinWidth="330"/></Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource ChromePanelStyle}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="NODE SCORE" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center"/>
                    <c:Gauge Width="180" Height="180" Value="{Binding AssessmentGaugeValue, Mode=OneWay}"
                             ArcBrush="{StaticResource GoldFill}" TextBrush="{StaticResource LcdGold}"
                             FontSize="34" RingThickness="16" Text="{Binding AssessmentScoreText}"/>
                    <TextBlock Text="{Binding AssessmentTier}" Style="{StaticResource Mono}" FontSize="15"
                               Foreground="{StaticResource InkPrimary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock Text="1000 = เครื่องอ้างอิง · คะแนนครึ่งหนึ่งเมื่อการ์ดช้าลงครึ่งหนึ่ง"
                               Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/>
                    <Button Style="{StaticResource ChromeButton}" Content="ประเมินเครื่องใหม่" Command="{Binding RunBenchmark}"
                            IsEnabled="{Binding BenchmarkRunning, Converter={StaticResource Not}}" Margin="0,12,0,0" Width="200"/>
                </StackPanel>
            </Border>
            <!-- Only while a measurement is actually running -->
            <Border Style="{StaticResource ChromePanelStyle}" Margin="0,13,0,0"
                    Visibility="{Binding ShowAssessmentProgress, Converter={StaticResource Vis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="กำลังประเมิน" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock Style="{StaticResource Mono}" FontSize="13" HorizontalAlignment="Right"
                                   Foreground="{StaticResource GoldAccentText}">
                            <Run Text="{Binding AssessmentOverallPercent, Mode=OneWay}"/><Run Text="%"/>
                        </TextBlock>
                    </Grid>

                    <!-- The overall bar, thicker than the per-stage ones so it reads first -->
                    <ProgressBar Style="{StaticResource Bar}" Height="12" Minimum="0" Maximum="100"
                                 Value="{Binding AssessmentOverallPercent, Mode=OneWay}"/>
                    <TextBlock Text="{Binding AssessmentStageText}" Style="{StaticResource Body}"
                               TextWrapping="Wrap" Margin="0,7,0,0"/>

                    <Border Height="1" Background="{StaticResource ChromeBorderLight}" Margin="0,11,0,9"/>

                    <ItemsControl ItemsSource="{Binding AssessmentSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,9">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,0,54,0">
                                            <TextBlock.Style>
                                                <!-- A stage nobody has reached yet is greyed; the
                                                     one running is the only one in full ink. -->
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Body}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="pending">
                                                            <Setter Property="Foreground" Value="{StaticResource InkMuted}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="running">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding PercentText}" Style="{StaticResource Mono}" FontSize="11"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Foreground="{StaticResource InkLabel}"/>
                                    </Grid>
                                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                 Value="{Binding Percent, Mode=OneWay}">
                                        <ProgressBar.Style>
                                            <!-- Green once the stage is done, gold while it runs -->
                                            <Style TargetType="ProgressBar" BasedOn="{StaticResource Bar}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="done">
                                                        <Setter Property="Foreground" Value="{StaticResource GreenFill}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ProgressBar.Style>
                                    </ProgressBar>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChromePanelStyle}" Margin="0,13,0,0">
                <StackPanel>
                    <TextBlock Text="ผลการประเมิน" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="{Binding BenchmarkText}" Style="{StaticResource Mono}" FontSize="13" Foreground="{StaticResource InkPrimary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding BenchmarkNote}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="2">
            <Border Style="{StaticResource ChromePanelStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="งานที่เครื่องนี้รับได้" Style="{StaticResource SectionLabel}" Margin="0"/>
                        <TextBlock Text="วัดจริง ไม่ใช่การประกาศเอง" Style="{StaticResource Mono}" FontSize="10" HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Capabilities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Kind}" Style="{StaticResource Body}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Verdict}" FontSize="11" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <!-- Three states, three colours: red is the only one
                                                 that means no work and no earnings. -->
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mono}">
                                                <Setter Property="Foreground" Value="#8a2f2f"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Lane}" Value="full">
                                                        <Setter Property="Foreground" Value="#1f6b3a"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Lane}" Value="slow">
                                                        <Setter Property="Foreground" Value="#8a6a1a"/>
                                                    </DataTrigger>
                                                    <!-- On trust, not yet earned: stated in blue rather
                                                         than in the green of a lane backed by real jobs. -->
                                                    <DataTrigger Binding="{Binding Provisional}" Value="True">
                                                        <Setter Property="Foreground" Value="#2f5d8a"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="รอบแรกเครื่องได้เต็มความเร็วไว้ก่อนทุกงานที่ VRAM และโมเดลพร้อม แล้วระบบจะปรับตามเวลาจริงเมื่อทำงานครบ 3 ชิ้น — เร็วกว่าที่คาดก็อยู่เต็มความเร็วต่อ ช้ากว่าก็ลงมาเป็น &quot;งานไม่เร่ง&quot; ซึ่งยังได้งานและได้เงิน แค่เป็นงานที่ไม่มีคนนั่งรอ ส่วน &quot;รับไม่ได้&quot; คือทำไม่ได้จริง ๆ"/>
                </StackPanel>
            </Border>

            <!-- Hidden entirely on a healthy node, so its presence means something -->
            <Border Style="{StaticResource ChromePanelStyle}" Margin="0,13,0,0"
                    Visibility="{Binding HasAssessmentWarnings, Converter={StaticResource Vis}}">
                <StackPanel>
                    <TextBlock Text="ข้อสังเกตเรื่องเครื่อง" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl ItemsSource="{Binding AssessmentWarnings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="!" Style="{StaticResource Mono}" FontSize="13"
                                               Foreground="#b0741a" FontWeight="Bold" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding}" Style="{StaticResource Body}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"
                               Text="ทั้งหมดนี้มีผลกับคะแนน แต่ไม่ได้ทำให้เครื่องรับงานไม่ได้ — แก้แล้วประเมินใหม่ คะแนนจะขึ้นเอง"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChromePanelStyle}" Margin="0,13,0,0">
                <StackPanel>
                    <TextBlock Text="SUB-SCORES · LIVE" Style="{StaticResource SectionLabel}"/>
                    <Grid Margin="0,2,0,6"><TextBlock Text="GPU load" Style="{StaticResource Body}"/><TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Right"><Run Text="{Binding LoadPct, Mode=OneWay}"/><Run Text="%"/></TextBlock></Grid>
                    <ProgressBar Style="{StaticResource Bar}" Minimum="0" Maximum="100" Value="{Binding LoadPct, Mode=OneWay}"/>
                    <Grid Margin="0,10,0,6"><TextBlock Text="Core temp" Style="{StaticResource Body}"/><TextBlock Style="{StaticResource Mono}" HorizontalAlignment="Right"><Run Text="{Binding TempC, Mode=OneWay}"/><Run Text=" °C"/></TextBlock></Grid>
                    <ProgressBar Style="{StaticResource Bar}" Foreground="{StaticResource OrangeFill}" Minimum="0" Maximum="100" Value="{Binding TempC, Mode=OneWay}"/>
                    <Grid Margin="0,10,0,6"><TextBlock Text="Session uptime" Style="{StaticResource Body}"/><TextBlock Text="{Binding UptimeText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/></Grid>
                    <ProgressBar Style="{StaticResource Bar}" Foreground="{StaticResource GreenFill}" Minimum="0" Maximum="1" Value="{Binding SuccessRateFraction, Mode=OneWay, FallbackValue=0}"/>
                    <Grid Margin="0,10,0,6"><TextBlock Text="Relay latency" Style="{StaticResource Body}"/><TextBlock Text="{Binding LatencyText}" Style="{StaticResource Mono}" HorizontalAlignment="Right"/></Grid>
                    <ProgressBar Style="{StaticResource Bar}" Foreground="{StaticResource BlueFill}" Minimum="0" Maximum="1" Value="{Binding LatencyFraction, Mode=OneWay, FallbackValue=0}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
