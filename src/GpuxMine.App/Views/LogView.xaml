<UserControl x:Class="GpuxMine.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GpuxMine.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Filter" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Face" Background="{StaticResource ChromeButtonFace}" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" CornerRadius="5" Padding="12,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Face" Property="Background" Value="{StaticResource GoldButtonFace}"/><Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource GoldBorder}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource InkStrong}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Filter}" Content="All"      IsChecked="{Binding LogFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=all, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource Filter}" Content="Jobs"     IsChecked="{Binding LogFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=jobs, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource Filter}" Content="Payouts"  IsChecked="{Binding LogFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=payouts, Mode=TwoWay}"/>
                <RadioButton Style="{StaticResource Filter}" Content="Warnings" IsChecked="{Binding LogFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=warnings, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="เก็บ 2,000 บรรทัดล่าสุดในหน่วยความจำ" Style="{StaticResource Mono}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Style="{StaticResource ChromeButton}" Content="Export" Command="{Binding ExportLog}" Padding="12,5"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource Console}" BorderBrush="{StaticResource LcdBorder}" BorderThickness="1" CornerRadius="9" Padding="14,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="Scroller" c:WheelScroll.Bubble="True">
                <ItemsControl ItemsSource="{Binding VisibleLog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11.5" LineHeight="21" TextWrapping="Wrap">
                                <Run Text="{Binding At, Mode=OneWay, StringFormat=HH:mm:ss}" Foreground="{StaticResource LcdDim}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Channel, Mode=OneWay, StringFormat=[{0}]}" Foreground="{Binding Channel, Converter={StaticResource ChannelBrush}}"/>
                                <Run Text="  "/>
                                <Run Text="{Binding Message, Mode=OneWay}" Foreground="#d5dde6"/>
                            </TextBlock>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
