<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>GpuxMine.App</RootNamespace>
    <AssemblyName>GPUxMINE</AssemblyName>
    <!-- Directory.Build.props sets InvariantGlobalization for the headless
         projects. WPF's font cache constructs real cultures at startup and
         throws under invariant mode before a single window opens — found by
         running the exe, not by building it. A Thai UI needs real cultures
         for number and date formatting anyway. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- No business logic lives here — the window binds to GpuxMine.Node.
         The day a Linux or Avalonia head is wanted, this is the only project
         that changes. -->
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\GpuxMine.Node\GpuxMine.Node.csproj" />
    <ProjectReference Include="..\GpuxMine.Hardware\GpuxMine.Hardware.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\ShareTechMono-Regular.ttf" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>
</Project>
