<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon lives in Windows Forms; WPF has no tray icon of its own and
         a worker that runs for days needs to live somewhere other than a window. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GpuxMine.App</RootNamespace>
    <AssemblyName>GPUxMINE</AssemblyName>
    <ApplicationIcon>Assets\gpuxmine.ico</ApplicationIcon>
    <!-- Directory.Build.props sets InvariantGlobalization for the headless
         projects. WPF's font cache constructs real cultures at startup and
         throws under invariant mode before a single window opens — found by
         running the exe, not by building it. A Thai UI needs real cultures
         for number and date formatting anyway. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- No business logic lives here — the window binds to GpuxMine.Node.
         The day a Linux or Avalonia head is wanted, this is the only project
         that changes. -->
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWindowsForms adds these to the implicit usings, and every one of
         them collides with its WPF namesake: Application, Brush, Point, Color.
         Only the tray icon needs Windows Forms, and it imports them by name. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GpuxMine.Node\GpuxMine.Node.csproj" />
    <ProjectReference Include="..\GpuxMine.Hardware\GpuxMine.Hardware.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\Fonts\ShareTechMono-Regular.ttf" />
    <Resource Include="Assets\logo.png" />
    <!-- พื้นผิวที่ codex วาดมาให้ตามพาเลตใน Theme.xaml -->
    <Resource Include="Assets\gfx\bg-tile.png" />
    <Resource Include="Assets\gfx\header-strip.png" />
    <Resource Include="Assets\gfx\button-plate.png" />
    <Resource Include="Assets\gfx\button-plate-hover.png" />
    <Resource Include="Assets\gfx\panel-bezel.png" />
    <Resource Include="Assets\gfx\emblem-watermark.png" />
    <Resource Include="Assets\icon.png" />
    <Resource Include="Assets\gpuxmine.ico" />
  </ItemGroup>
</Project>
