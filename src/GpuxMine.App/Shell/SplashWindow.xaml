<Window x:Class="GpuxMine.App.Shell.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GPUxMINE" Width="460" Height="352"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- เข้ามาแบบซูม: เล็กกว่าจริงแล้วคลี่ออก
                         CubicEase ขาออก ทำให้หยุดนิ่งเองโดยไม่กระตุกตอนจบ -->
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleX"
                                     From="0.72" To="1" Duration="0:0:0.75">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoScale" Storyboard.TargetProperty="ScaleY"
                                     From="0.72" To="1" Duration="0:0:0.75">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LogoBox" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.45"/>

                    <!-- คำโปรยกับเลขเวอร์ชันตามมาทีหลัง ไม่ขึ้นพร้อมกันทั้งหมด -->
                    <DoubleAnimation Storyboard.TargetName="Tagline" Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.35" Duration="0:0:0.4"/>

                    <!-- ประกายโลหะ: แถบสว่างแคบกวาดทแยงผ่านตัวอักษร
                         สามจุดสีเลื่อนพร้อมกันเพื่อให้แถบคงความกว้างไว้ตลอดทาง
                         เริ่มหลังซูมจบแล้ววนซ้ำ -->
                    <DoubleAnimation Storyboard.TargetName="ShineLead" Storyboard.TargetProperty="Offset"
                                     From="-0.45" To="1.05" BeginTime="0:0:0.6" Duration="0:0:1.3"
                                     RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="ShinePeak" Storyboard.TargetProperty="Offset"
                                     From="-0.30" To="1.20" BeginTime="0:0:0.6" Duration="0:0:1.3"
                                     RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="ShineTail" Storyboard.TargetProperty="Offset"
                                     From="-0.15" To="1.35" BeginTime="0:0:0.6" Duration="0:0:1.3"
                                     RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border CornerRadius="12" Background="{StaticResource ChromePanel}"
            BorderBrush="{StaticResource ChromeBorderDark}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="5" Opacity="0.35"/>
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- โลโก้ + ชื่อ -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Grid x:Name="LogoBox" Width="230" RenderTransformOrigin="0.5,0.5" Opacity="0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.72" ScaleY="0.72"/>
                    </Grid.RenderTransform>

                    <Image x:Name="LogoImage" Source="/Assets/logo.png" Width="230"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <!-- แถบประกายถูกตัดด้วยรูปร่างของโลโก้เองผ่าน OpacityMask
                         จึงวิ่งอยู่บนตัวอักษรเท่านั้น ไม่เลอะพื้นหลัง -->
                    <Rectangle IsHitTestVisible="False"
                               Width="{Binding ActualWidth, ElementName=LogoImage}"
                               Height="{Binding ActualHeight, ElementName=LogoImage}">
                        <Rectangle.OpacityMask>
                            <ImageBrush ImageSource="/Assets/logo.png"/>
                        </Rectangle.OpacityMask>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0.25" EndPoint="1,0.75">
                                <GradientStop x:Name="ShineLead" Color="#00FFFFFF" Offset="-0.45"/>
                                <GradientStop x:Name="ShinePeak" Color="#CCFFFFFF" Offset="-0.30"/>
                                <GradientStop x:Name="ShineTail" Color="#00FFFFFF" Offset="-0.15"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <StackPanel x:Name="Tagline" Opacity="0">
                    <TextBlock Text="แบ่งปันการ์ดจอ รับงาน AI" Style="{StaticResource Muted}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Style="{StaticResource Mono}" FontSize="10.5" HorizontalAlignment="Center"
                               Foreground="{StaticResource InkMuted}" Margin="0,3,0,0">
                        <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- สิ่งที่กำลังตรวจ: ชื่อขั้นตอน ผลลัพธ์ และแถบความคืบหน้า -->
            <Border Grid.Row="1" Background="{StaticResource Lcd}" CornerRadius="0,0,11,11"
                    BorderBrush="{StaticResource ChromeBorderLight}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel>
                    <Grid Margin="0,0,0,7">
                        <TextBlock Text="{Binding StepText}" Style="{StaticResource LcdLabelText}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StepCountText}" Style="{StaticResource Mono}" FontSize="10"
                                   Foreground="{StaticResource LcdBlue}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Border Height="6" CornerRadius="3" Background="#20303c">
                        <Border HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource GoldCell}"
                                Width="{Binding BarWidth}"/>
                    </Border>

                    <!-- ผลของขั้นตอนล่าสุด บอกสิ่งที่พบจริง ไม่ใช่แค่ว่า "เสร็จแล้ว" -->
                    <TextBlock Text="{Binding DetailText}" Style="{StaticResource Mono}" FontSize="10.5"
                               Foreground="{StaticResource LcdBlue}" Margin="0,8,0,0"
                               TextWrapping="Wrap" MinHeight="28" VerticalAlignment="Top"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
