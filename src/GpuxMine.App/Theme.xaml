<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:GpuxMine.App.Controls">

    <!-- Converters live at application level so a screen can use them before
         it is parented into the window (StaticResource resolves at load). -->
    <c:EqualsToBool x:Key="EqualsToBool"/>
    <c:BoolToVisibility x:Key="Vis"/>
    <c:BoolToVisibility x:Key="VisInv" Invert="True"/>
    <c:NullToVisibility x:Key="NullVis"/>
    <c:BoolInvert x:Key="Not"/>
    <c:WidthAtLeast x:Key="WidthAtLeast"/>
    <c:ChannelToBrush x:Key="ChannelBrush"/>

    <!-- ======================================================================
         GPUxMINE design system — brushed chrome, gold for money and primary
         actions, dark LCD readouts. Every value here is from the design
         handoff README; screens compose these and add nothing of their own.
         ====================================================================== -->

    <!-- Fonts -->
    <FontFamily x:Key="UiFont">Tahoma, Verdana, Geneva, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Assets/Fonts/#Share Tech Mono</FontFamily>

    <!-- Ink -->
    <SolidColorBrush x:Key="InkPrimary" Color="#262b31"/>
    <SolidColorBrush x:Key="InkStrong" Color="#2c3238"/>
    <SolidColorBrush x:Key="InkSecondary" Color="#4e565f"/>
    <SolidColorBrush x:Key="InkLabel" Color="#6b737d"/>
    <SolidColorBrush x:Key="InkMuted" Color="#8d949c"/>
    <SolidColorBrush x:Key="InkOnGold" Color="#3a2c07"/>
    <SolidColorBrush x:Key="GoldAccentText" Color="#8a6a1a"/>
    <SolidColorBrush x:Key="StatusText" Color="#4b5259"/>

    <!-- LCD text -->
    <SolidColorBrush x:Key="LcdLabel" Color="#8c98a4"/>
    <SolidColorBrush x:Key="LcdGold" Color="#ffd77a"/>
    <SolidColorBrush x:Key="LcdBlue" Color="#cfe4ff"/>
    <SolidColorBrush x:Key="LcdDim" Color="#6b7783"/>
    <SolidColorBrush x:Key="LcdGreen" Color="#7fe07a"/>
    <SolidColorBrush x:Key="LcdOrange" Color="#ffae6a"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="Green" Color="#3fae3a"/>
    <SolidColorBrush x:Key="Orange" Color="#e07a2a"/>
    <SolidColorBrush x:Key="Red" Color="#d8574a"/>
    <SolidColorBrush x:Key="RedDark" Color="#c2542f"/>
    <SolidColorBrush x:Key="Blue" Color="#4f86c6"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="ChromeBorder" Color="#969ea8"/>
    <SolidColorBrush x:Key="ChromeBorderLight" Color="#b3bac2"/>
    <SolidColorBrush x:Key="ChromeBorderDark" Color="#6b737c"/>
    <SolidColorBrush x:Key="ButtonBorder" Color="#8a929b"/>
    <SolidColorBrush x:Key="GoldBorder" Color="#8d6f18"/>
    <SolidColorBrush x:Key="GoldBorderNav" Color="#9d7a1c"/>
    <SolidColorBrush x:Key="TitleBorder" Color="#7d641c"/>
    <SolidColorBrush x:Key="LcdBorder" Color="#79818a"/>
    <SolidColorBrush x:Key="TroughBorder" Color="#7c848d"/>
    <SolidColorBrush x:Key="SidebarBorder" Color="#9ea6af"/>

    <!-- Backdrop behind the fixed window -->
    <RadialGradientBrush x:Key="Backdrop" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.9" RadiusY="1.1">
        <GradientStop Color="#5b6470" Offset="0"/>
        <GradientStop Color="#2b3138" Offset="0.7"/>
        <GradientStop Color="#1b2026" Offset="1"/>
    </RadialGradientBrush>

    <!-- Outer chrome bezel (160deg) -->
    <LinearGradientBrush x:Key="Bezel" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#fdfdfe" Offset="0"/>
        <GradientStop Color="#dde1e7" Offset="0.38"/>
        <GradientStop Color="#b9c0c9" Offset="0.70"/>
        <GradientStop Color="#8d95a0" Offset="1"/>
    </LinearGradientBrush>

    <!-- Title bar — gold -->
    <LinearGradientBrush x:Key="TitleGold" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fffbee" Offset="0"/>
        <GradientStop Color="#f4e2ab" Offset="0.16"/>
        <GradientStop Color="#e0bd5c" Offset="0.50"/>
        <GradientStop Color="#c0952c" Offset="0.78"/>
        <GradientStop Color="#a37c18" Offset="1"/>
    </LinearGradientBrush>

    <!-- Menu bar -->
    <LinearGradientBrush x:Key="MenuBar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fbfcfd" Offset="0"/>
        <GradientStop Color="#e7eaee" Offset="0.6"/>
        <GradientStop Color="#d4d9df" Offset="1"/>
    </LinearGradientBrush>

    <!-- Sidebar (100deg ≈ left→right) -->
    <LinearGradientBrush x:Key="Sidebar" StartPoint="0,0" EndPoint="1,0.18">
        <GradientStop Color="#f4f6f8" Offset="0"/>
        <GradientStop Color="#dfe4ea" Offset="0.52"/>
        <GradientStop Color="#c7cdd5" Offset="1"/>
    </LinearGradientBrush>

    <!-- Content area -->
    <LinearGradientBrush x:Key="Content" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#eef1f4" Offset="0"/>
        <GradientStop Color="#dee3e9" Offset="0.72"/>
        <GradientStop Color="#ced5dc" Offset="1"/>
    </LinearGradientBrush>

    <!-- Chrome panel -->
    <LinearGradientBrush x:Key="ChromePanel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fcfdfe" Offset="0"/>
        <GradientStop Color="#e3e8ed" Offset="0.46"/>
        <GradientStop Color="#c7ced6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Nav rows -->
    <LinearGradientBrush x:Key="NavInactive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fdfdfe" Offset="0"/>
        <GradientStop Color="#eceff3" Offset="0.5"/>
        <GradientStop Color="#dbe0e6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavActive" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fffbee" Offset="0"/>
        <GradientStop Color="#f3e0a7" Offset="0.2"/>
        <GradientStop Color="#e0bd5c" Offset="0.6"/>
        <GradientStop Color="#c8a039" Offset="1"/>
    </LinearGradientBrush>

    <!-- LCD -->
    <LinearGradientBrush x:Key="Lcd" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#11161b" Offset="0"/>
        <GradientStop Color="#1e252c" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Console" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0d1114" Offset="0"/>
        <GradientStop Color="#171d23" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Trough" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0e1114" Offset="0"/>
        <GradientStop Color="#22282e" Offset="1"/>
    </LinearGradientBrush>

    <!-- Fills -->
    <LinearGradientBrush x:Key="GoldFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffeaa9" Offset="0"/>
        <GradientStop Color="#d8a62f" Offset="0.55"/>
        <GradientStop Color="#a87c18" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GreenFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#bdf7a6" Offset="0"/>
        <GradientStop Color="#3fae3a" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#cfe4ff" Offset="0"/>
        <GradientStop Color="#4f86c6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="OrangeFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffd7b0" Offset="0"/>
        <GradientStop Color="#d9772a" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GreyFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#eef1f5" Offset="0"/>
        <GradientStop Color="#c6ccd4" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GoldCell" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#f4e2ab" Offset="0"/>
        <GradientStop Color="#c0952c" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BlueCell" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#cfe4ff" Offset="0"/>
        <GradientStop Color="#7ba3cf" Offset="1"/>
    </LinearGradientBrush>

    <!-- Buttons -->
    <LinearGradientBrush x:Key="GoldButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fffbee" Offset="0"/>
        <GradientStop Color="#f4e2ab" Offset="0.18"/>
        <GradientStop Color="#e0bd5c" Offset="0.52"/>
        <GradientStop Color="#bd9229" Offset="0.80"/>
        <GradientStop Color="#a37c18" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ChromeButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#e4e8ed" Offset="0.45"/>
        <GradientStop Color="#c0c7cf" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CloseButtonFace" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffb0a4" Offset="0"/>
        <GradientStop Color="#d8574a" Offset="0.48"/>
        <GradientStop Color="#a93023" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SilverDisc" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ffffff" Offset="0"/>
        <GradientStop Color="#d6dbe1" Offset="0.5"/>
        <GradientStop Color="#aab2bb" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToggleOn" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#caa53a" Offset="0"/>
        <GradientStop Color="#a4801a" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ToggleOff" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9aa3ad" Offset="0"/>
        <GradientStop Color="#6e7680" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Cream" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fffdf4" Offset="0"/>
        <GradientStop Color="#f6ead0" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===================== text styles ===================== -->

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource InkLabel}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <!-- Narrow the window and "JOBS DONE TODAY" silently became
             "JOBS DONE TODA". A heading that loses its last letter without
             saying so is the cut-off text this layout is supposed to be free
             of; two lines is the honest answer. -->
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource InkStrong}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="BodyBold" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource Body}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource InkLabel}"/>
    </Style>
    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource InkSecondary}"/>
    </Style>
    <Style x:Key="LcdLabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="9.5"/>
        <Setter Property="Foreground" Value="{StaticResource LcdLabel}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>
    <Style x:Key="LcdValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{StaticResource LcdGold}"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#ffbe46" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LcdValueBlue" TargetType="TextBlock" BasedOn="{StaticResource LcdValue}">
        <Setter Property="Foreground" Value="{StaticResource LcdBlue}"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style x:Key="LcdValueGreen" TargetType="TextBlock" BasedOn="{StaticResource LcdValue}">
        <Setter Property="Foreground" Value="{StaticResource LcdGreen}"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>
    <Style x:Key="BigNumber" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="62"/>
        <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
    </Style>

    <!-- ===================== panels ===================== -->

    <!-- ══ พื้นผิวจากไฟล์ภาพ ══
         วาดด้วย System.Drawing ตามพาเลตข้างบน จึงเข้าชุดกับ gradient ที่เหลือ
         ตรวจแล้ว: bg-tile ต่อลายไร้รอยต่อจริง (ขอบซ้าย/ขวา ต่างกัน 0.00)
         และคอนทราสต์ในลายแค่ 0.8% จึงไม่แย่งสายตาไปจากตัวเลขบนจอ -->
    <ImageBrush x:Key="LcdTexture" ImageSource="/Assets/gfx/bg-tile.png"
                TileMode="Tile" ViewportUnits="Absolute" Viewport="0,0,256,256"
                Opacity="0.5" Stretch="None"/>

    <!-- แถบหัวโปรแกรม: ยืดตามความกว้างหน้าต่าง เส้นทองที่ขอบล่างมากับภาพ -->
    <ImageBrush x:Key="HeaderStrip" ImageSource="/Assets/gfx/header-strip.png" Stretch="Fill"/>

    <Style x:Key="ChromePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChromePanel}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ChromeBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.22"/>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="LcdPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Lcd}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LcdBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="7"/>
        <Setter Property="Padding" Value="12,10"/>
        <!-- ลายโลหะทับบน gradient เดิม ไม่ได้แทนที่มัน: gradient คือสิ่งที่ทำให้
             จอดูโค้ง ส่วนลายคือสิ่งที่ทำให้มันดูเป็นวัสดุ เอาออกอันใดอันหนึ่ง
             แล้วมันจะแบน -->
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.30"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ใช้ซ้อนใน LcdPanelStyle เมื่ออยากได้ลายวัสดุ วางเป็นลูกใบแรกของ Border -->
    <Style x:Key="LcdTextureLayer" TargetType="Rectangle">
        <Setter Property="Fill" Value="{StaticResource LcdTexture}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="RadiusX" Value="6"/>
        <Setter Property="RadiusY" Value="6"/>
    </Style>
    <Style x:Key="TroughStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Trough}"/>
        <Setter Property="BorderBrush" Value="{StaticResource TroughBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <!-- ===================== buttons ===================== -->

    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource InkOnGold}"/>
        <Setter Property="Padding" Value="18,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{StaticResource GoldButtonFace}" BorderBrush="{StaticResource GoldBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.3"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.92"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource InkStrong}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" Background="{StaticResource ChromeButtonFace}" BorderBrush="{StaticResource ButtonBorder}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.25"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.9"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation row: a RadioButton so exactly one is active -->

    <!-- ══ ไอคอนเมนูข้าง ══
         วาดเป็นเวกเตอร์เอง ไม่ใช้ฟอนต์ไอคอน (Segoe MDL2 / Fluent) เพราะฟอนต์
         ที่เครื่องปลายทางไม่มีจะกลายเป็นสี่เหลี่ยมโหว่ และเรากำลังส่งโปรแกรมนี้
         ไปลงเครื่องคนอื่นที่เราไม่ได้เลือก Windows รุ่นให้
         ทุกตัววาดบนผืน 16×16 เป็นเส้น ให้เข้ากับงานเส้นของ chrome ทั้งชุด -->
    <Geometry x:Key="NavIcoDashboard">M2,12 A6,6 0 1 1 14,12 M8,12 L11.5,7.5</Geometry>
    <Geometry x:Key="NavIcoPower">M9.5,1.5 L4,9 H7.5 L6.5,14.5 L12,7 H8.5 Z</Geometry>
    <Geometry x:Key="NavIcoModels">M8,2 L14,5.5 L8,9 L2,5.5 Z M2,9.5 L8,13 L14,9.5</Geometry>
    <Geometry x:Key="NavIcoQueue">M2,4 H10 M2,8 H10 M2,12 H7 M11.5,9.5 L15,12 L11.5,14.5 Z</Geometry>
    <Geometry x:Key="NavIcoWallet">M2,4.5 H12.5 A1.5,1.5 0 0 1 14,6 V12 A1.5,1.5 0 0 1 12.5,13.5 H3.5 A1.5,1.5 0 0 1 2,12 Z M10.5,9 H12.5</Geometry>
    <Geometry x:Key="NavIcoBenchmark">M2,14 H14 M4,14 V9 M7.5,14 V3.5 M11,14 V6.5</Geometry>
    <Geometry x:Key="NavIcoLog">M4,2 H9.5 L12.5,5 V14 H4 Z M9.5,2 V5 H12.5 M6,8 H10.5 M6,11 H10.5</Geometry>
    <Geometry x:Key="NavIcoReferrals">M4.2,8 L10.5,4.6 M4.2,8 L10.5,11.4 M4,8 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 M12,4 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0 M12,12 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0</Geometry>
    <Geometry x:Key="NavIcoSettings">M2,4.5 H13.5 M2,11.5 H13.5 M5.5,4.5 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0 M10,11.5 m-1.6,0 a1.6,1.6 0 1,0 3.2,0 a1.6,1.6 0 1,0 -3.2,0</Geometry>

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource InkStrong}"/>
        <Setter Property="Margin" Value="0,0,0,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Row" Background="{StaticResource NavInactive}" BorderBrush="{StaticResource ChromeBorderLight}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <StackPanel Orientation="Horizontal">
                            <!-- Tag คือรูปทรงของไอคอน ตั้งไว้ที่ปุ่มแต่ละตัวใน MainWindow
                                 เก็บไว้ใน Viewbox 16×16 ให้ทุกไอคอนกินที่เท่ากันเป๊ะ
                                 ข้อความจึงเรียงตรงกันทุกแถวไม่ว่าไอคอนจะรูปร่างอย่างไร -->
                            <Viewbox Width="15" Height="15" Margin="0,0,9,0" VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Path x:Name="Ico" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Stroke="{StaticResource InkLabel}" StrokeThickness="1.4"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource NavActive}"/>
                            <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource GoldBorderNav}"/>
                            <Setter TargetName="Ico" Property="Stroke" Value="{StaticResource GoldBorderNav}"/>
                            <Setter TargetName="Ico" Property="StrokeThickness" Value="1.7"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Opacity" Value="0.92"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 44×22 pill toggle with a chrome knob -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <!-- Grid ไม่ใช่ StackPanel แนวนอน
                         StackPanel แนวนอนวัดลูกด้วยความกว้างไม่จำกัด ข้อความที่ตั้ง
                         TextWrapping ไว้จึงไม่มีวันขึ้นบรรทัดใหม่ — มันยาวออกไปเรื่อย ๆ
                         แล้วโดนพ่อแม่ตัดทิ้งกลางคำ เห็นชัดตอนย่อหน้าต่าง:
                         "(เขียนคีย์ Run ข" แล้วหายไปดื้อ ๆ
                         คอลัมน์ * ให้ความกว้างที่แท้จริง การ wrap จึงทำงาน -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="44" Height="22" Margin="0,0,10,0" VerticalAlignment="Top">
                            <Border x:Name="Track" CornerRadius="11" Background="{StaticResource ToggleOff}" BorderBrush="#5c646d" BorderThickness="1"/>
                            <Border x:Name="Knob" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" Margin="2,0,0,0"
                                    Background="{StaticResource ChromeButtonFace}" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1">
                                <Border.RenderTransform><TranslateTransform x:Name="KnobShift" X="0"/></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource ToggleOn}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource GoldBorder}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.15"/></Storyboard></BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Progress bar drawn as trough + fill; Foreground picks the fill brush -->
    <Style x:Key="Bar" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource GoldFill}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{StaticResource Trough}" BorderBrush="{StaticResource TroughBorder}" BorderThickness="1" CornerRadius="5" Padding="1">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4" Background="{TemplateBinding Foreground}">
                                <Border.Effect><DropShadowEffect Color="#ffbe46" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Power slider: dark trough, gold fill, chrome thumb with grip lines -->
    <Style x:Key="PowerSlider" TargetType="Slider">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border Height="14" VerticalAlignment="Center" Background="{StaticResource Trough}" BorderBrush="{StaticResource TroughBorder}" BorderThickness="1" CornerRadius="7"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="10" Margin="2,0,0,0" CornerRadius="5" Background="{StaticResource GoldFill}">
                                                <Border.Effect><DropShadowEffect Color="#ffbe46" BlurRadius="8" ShadowDepth="0" Opacity="0.5"/></Border.Effect>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="22" Height="34" Cursor="Hand">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="{StaticResource ChromeButtonFace}" BorderBrush="{StaticResource ButtonBorder}" BorderThickness="1" CornerRadius="5">
                                                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Direction="270" Opacity="0.3"/></Border.Effect>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Rectangle Width="1" Height="12" Fill="#8a929b" Margin="1,0"/>
                                                    <Rectangle Width="1" Height="12" Fill="#8a929b" Margin="1,0"/>
                                                    <Rectangle Width="1" Height="12" Fill="#8a929b" Margin="1,0"/>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain text input on chrome -->
    <Style x:Key="ChromeInput" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource InkPrimary}"/>
        <Setter Property="Background" Value="#fbfcfd"/>
        <Setter Property="BorderBrush" Value="{StaticResource ButtonBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ══════════ Scrollbars ══════════
         One style for the whole app. The trough is a translucent black so the
         same bar sits correctly on the light chrome panels AND on the dark
         console in the log view; only the thumb carries the metal. -->

    <SolidColorBrush x:Key="ScrollTrough" Color="#1e000000"/>
    <SolidColorBrush x:Key="ScrollGrip" Color="#8d95a0"/>

    <LinearGradientBrush x:Key="ScrollThumbV" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#fdfdfe" Offset="0"/>
        <GradientStop Color="#e2e7ec" Offset="0.45"/>
        <GradientStop Color="#bcc3cb" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollThumbVHot" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#fffbee" Offset="0"/>
        <GradientStop Color="#f0dca4" Offset="0.45"/>
        <GradientStop Color="#cfa93c" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollThumbH" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fdfdfe" Offset="0"/>
        <GradientStop Color="#e2e7ec" Offset="0.45"/>
        <GradientStop Color="#bcc3cb" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ScrollThumbHHot" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#fffbee" Offset="0"/>
        <GradientStop Color="#f0dca4" Offset="0.45"/>
        <GradientStop Color="#cfa93c" Offset="1"/>
    </LinearGradientBrush>

    <!-- Clicking the trough still pages, it just draws nothing -->
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyleV" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Margin="2,0" SnapsToDevicePixels="True">
                        <Border x:Name="Face" CornerRadius="4" Background="{StaticResource ScrollThumbV}"
                                BorderBrush="{StaticResource ChromeBorderDark}" BorderThickness="1"/>
                        <Border CornerRadius="3" Margin="1" BorderThickness="1" BorderBrush="#70ffffff" IsHitTestVisible="False"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Rectangle Width="7" Height="1" Fill="{StaticResource ScrollGrip}" Margin="0,0,0,2"/>
                            <Rectangle Width="7" Height="1" Fill="{StaticResource ScrollGrip}" Margin="0,0,0,2"/>
                            <Rectangle Width="7" Height="1" Fill="{StaticResource ScrollGrip}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ScrollThumbVHot}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource GoldBorder}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource GoldFill}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource GoldBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollThumbStyleH" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Margin="0,2" SnapsToDevicePixels="True">
                        <Border x:Name="Face" CornerRadius="4" Background="{StaticResource ScrollThumbH}"
                                BorderBrush="{StaticResource ChromeBorderDark}" BorderThickness="1"/>
                        <Border CornerRadius="3" Margin="1" BorderThickness="1" BorderBrush="#70ffffff" IsHitTestVisible="False"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <Rectangle Width="1" Height="7" Fill="{StaticResource ScrollGrip}" Margin="0,0,2,0"/>
                            <Rectangle Width="1" Height="7" Fill="{StaticResource ScrollGrip}" Margin="0,0,2,0"/>
                            <Rectangle Width="1" Height="7" Fill="{StaticResource ScrollGrip}"/>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource ScrollThumbHHot}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource GoldBorder}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{StaticResource GoldFill}"/>
                            <Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource GoldBorder}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Border Background="{StaticResource ScrollTrough}" CornerRadius="5" Margin="3,1"/>
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumbStyleV}" MinHeight="30"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Border Background="{StaticResource ScrollTrough}" CornerRadius="5" Margin="1,3"/>
                                <Track x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumbStyleH}" MinWidth="30"/>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
